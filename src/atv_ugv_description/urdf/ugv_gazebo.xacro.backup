<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="front_left_link">
    <mu1>1.5</mu1>
    <mu2>0.25</mu2>
    <fdir1>1 0 0</fdir1>
    <slip1>0.005</slip1>
    <slip2>0.15</slip2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="front_right_link">
    <mu1>1.5</mu1>
    <mu2>0.25</mu2>
    <fdir1>1 0 0</fdir1>
    <slip1>0.005</slip1>
    <slip2>0.15</slip2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="rear_left_link">
    <mu1>1.5</mu1>
    <mu2>0.25</mu2>
    <fdir1>1 0 0</fdir1>
    <slip1>0.005</slip1>
    <slip2>0.15</slip2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="rear_right_link">
    <mu1>1.5</mu1>
    <mu2>0.25</mu2>
    <fdir1>1 0 0</fdir1>
    <slip1>0.005</slip1>
    <slip2>0.15</slip2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="lidar_link">

    <sensor name="lidar" type="gpu_lidar">

      <always_on>true</always_on>
      <frame_id>lidar_link</frame_id>
      <visualize>true</visualize>
      <update_rate>10</update_rate>

      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>

    </sensor>

  </gazebo>

  <gazebo>
    <plugin
      filename="ign_ros2_control-system"
      name="ign_ros2_control::IgnitionROS2ControlPlugin">

      <parameters>
        /home/anand/atv_ugv_ws/src/atv_ugv_description/config/controllers.yaml
      </parameters>

    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

</robot>
