<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="atv_navigation_world">

    <!-- ================= PHYSICS ================= -->

    <gravity>0 0 -9.8</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1.0</real_time_update_rate>
    </physics>

    <!-- Required Gazebo world systems -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- IMU system -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>


    <!-- ================= GROUND ================= -->

    <model name="ground">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ================= SCENE ================= -->

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>1 1 1 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- ================= OUTER WALLS ================= -->

    <model name="outer_north">
      <static>true</static>
      <pose>0 8 1.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>16 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>16 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="outer_south">
      <static>true</static>
      <pose>0 -8 1.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>16 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>16 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="outer_east">
      <static>true</static>
      <pose>8 0 1.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 16 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 16 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="outer_west">
      <static>true</static>
      <pose>-8 0 1.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 16 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 16 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ================= INTERNAL WALLS ================= -->

    <model name="wall_1">
      <static>true</static>
      <pose>-3.5 3.0 1.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>7 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="wall_2">
      <static>true</static>
      <pose>3.5 -2.5 1.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>7 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="wall_3">
      <static>true</static>
      <pose>-3.0 -1.5 1.25 0 0 1.5708</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>5 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="wall_4">
      <static>true</static>
      <pose>3.0 2.0 1.25 0 0 1.5708</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="wall_5">
      <static>true</static>
      <pose>0 5.2 1.25 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.15 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.15 2.5</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ================= BOXES ================= -->

    <model name="box_1">
      <static>true</static>
      <pose>1.5 1.0 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="box_2">
      <static>true</static>
      <pose>-1.5 -4.5 0.5 0 0 0.4</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.8 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.8 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="box_3">
      <static>true</static>
      <pose>5.0 5.0 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ================= CYLINDERS ================= -->

    <model name="cylinder_1">
      <static>true</static>
      <pose>-5.0 5.0 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="cylinder_2">
      <static>true</static>
      <pose>5.0 -5.0 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="cylinder_3">
      <static>true</static>
      <pose>-5.0 -5.0 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ================= SUN ================= -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

  </world>
</sdf>
