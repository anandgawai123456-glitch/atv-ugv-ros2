<?xml version="1.0"?>

<robot name="atv_ugv"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================================================== -->
  <!-- MATERIALS                                               -->
  <!-- ====================================================== -->

  <material name="red">
    <color rgba="0.85 0.10 0.00 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>


  <!-- ====================================================== -->
  <!-- BASE FOOTPRINT                                          -->
  <!-- ====================================================== -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin
      xyz="0 0 0.118"
      rpy="0 0 0"/>
  </joint>


  <!-- ====================================================== -->
  <!-- BASE / CHASSIS                                          -->
  <!-- ====================================================== -->

  <link name="base_link">

    <inertial>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="40.0"/>

      <inertia
        ixx="3.0"
        ixy="0.0"
        ixz="0.0"
        iyy="5.0"
        iyz="0.0"
        izz="6.0"/>

    </inertial>


    <!-- ================================================== -->
    <!-- BODY VISUAL                                         -->
    <!-- ================================================== -->

    <visual>

      <origin
        xyz="0.0957436 -0.0675495 -0.0479803"
        rpy="0 0 0"/>

      <geometry>

        <mesh
          filename="package://atv_ugv_description/meshes/body.stl"
          scale="0.001 0.001 0.001"/>

      </geometry>

      <material name="red"/>

    </visual>


    <!-- ================================================== -->
    <!-- BODY COLLISION                                      -->
    <!-- ================================================== -->

    <collision>

      <origin
        xyz="0 0 0.03"
        rpy="0 0 0"/>

      <geometry>

        <box
          size="0.35 0.18 0.06"/>

      </geometry>

    </collision>

  </link>


  <!-- ====================================================== -->
  <!-- WHEEL MACRO                                             -->
  <!-- ====================================================== -->

  <xacro:macro
    name="wheel"
    params="prefix x y z mesh vx vy vz">


    <!-- ================================================== -->
    <!-- WHEEL LINK                                         -->
    <!-- ================================================== -->

    <link name="${prefix}_wheel_link">

      <inertial>

        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <mass value="5.0"/>

        <inertia
          ixx="0.06"
          ixy="0.0"
          ixz="0.0"
          iyy="0.06"
          iyz="0.0"
          izz="0.10"/>

      </inertial>


      <!-- ================================================ -->
      <!-- WHEEL VISUAL                                     -->
      <!-- ================================================ -->

      <visual>

        <origin
          xyz="${vx} ${vy} ${vz}"
          rpy="0 0 0"/>

        <geometry>

          <mesh
            filename="package://atv_ugv_description/meshes/${mesh}"
            scale="0.001 0.001 0.001"/>

        </geometry>

        <material name="black"/>

      </visual>


      <!-- ================================================ -->
      <!-- WHEEL COLLISION                                  -->
      <!-- ================================================ -->
      <!--
        URDF cylinder default axis = Z.

        Wheel axle must be Y.

        Rotate collision +90 degrees around X:

        Z -> Y
      -->

      <collision>

        <origin
          xyz="0 0 0"
          rpy="1.5708 0 0"/>

        <geometry>

          <cylinder
            radius="0.05"
            length="0.08"/>

        </geometry>


        <surface>

          <friction>

            <ode>

              <mu>5.0</mu>
              <mu2>1.0</mu2>

            </ode>


            <bullet>

              <friction>1.0</friction>
              <friction2>1.0</friction2>
              <rolling_friction>0.1</rolling_friction>

            </bullet>

          </friction>

        </surface>

      </collision>

    </link>


    <!-- ================================================== -->
    <!-- WHEEL JOINT                                        -->
    <!-- ================================================== -->

    <joint
      name="${prefix}_wheel_joint"
      type="continuous">

      <parent link="base_link"/>

      <child link="${prefix}_wheel_link"/>

      <!-- Wheel center -->

      <origin
        xyz="${x} ${y} ${z}"
        rpy="0 0 0"/>

      <!-- Wheel axle -->

      <axis
        xyz="0 1 0"/>

    </joint>


    <!-- ================================================== -->
    <!-- GAZEBO WHEEL CONTACT                               -->
    <!-- ================================================== -->

    <gazebo reference="${prefix}_wheel_link">

      <mu1>1.0</mu1>
      <mu2>1.0</mu2>

      <kp>100000.0</kp>
      <kd>20.0</kd>

    </gazebo>

  </xacro:macro>


  <!-- ====================================================== -->
  <!-- FRONT LEFT WHEEL                                       -->
  <!-- ====================================================== -->

  <xacro:wheel
    prefix="front_left"

    x="0.11119"
    y="0.04905"
    z="-0.068"

    vx="-0.019"
    vy="-0.110"
    vz="0.014"

    mesh="wheel_front_left.stl"/>


  <!-- ====================================================== -->
  <!-- FRONT RIGHT WHEEL                                      -->
  <!-- ====================================================== -->

  <xacro:wheel
    prefix="front_right"

    x="0.11116"
    y="-0.05105"
    z="-0.068"

    vx="-0.020"
    vy="-0.022"
    vz="0.015"

    mesh="wheel_front_right.stl"/>


  <!-- ====================================================== -->
  <!-- REAR LEFT WHEEL                                        -->
  <!-- ====================================================== -->

  <xacro:wheel
    prefix="rear_left"

    x="-0.13591"
    y="0.05305"
    z="-0.068"

    vx="0.232"
    vy="-0.110"
    vz="0.014"

    mesh="wheel_rear_left.stl"/>


  <!-- ====================================================== -->
  <!-- REAR RIGHT WHEEL                                       -->
  <!-- ====================================================== -->

  <xacro:wheel
    prefix="rear_right"

    x="-0.13586"
    y="-0.05205"
    z="-0.068"

    vx="0.232"
    vy="-0.022"
    vz="0.015"

    mesh="wheel_rear_right.stl"/>


  <!-- ====================================================== -->
  <!-- LIDAR LINK                                             -->
  <!-- ====================================================== -->

  <link name="lidar_link">

    <visual>

      <geometry>

        <cylinder
          radius="0.035"
          length="0.04"/>

      </geometry>

      <material name="black"/>

    </visual>

  </link>


  <!-- ====================================================== -->
  <!-- LIDAR JOINT                                             -->
  <!-- ====================================================== -->

  <joint
    name="lidar_joint"
    type="fixed">

    <parent link="base_link"/>

    <child link="lidar_link"/>

    <origin
      xyz="0 0 0.08"
      rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!-- LIDAR SENSOR                                            -->
  <!-- ====================================================== -->

  <gazebo reference="lidar_link">

    <sensor
      name="lidar"
      type="gpu_lidar">

      <always_on>true</always_on>

      <frame_id>lidar_link</frame_id>

      <visualize>true</visualize>

      <update_rate>10</update_rate>


      <lidar>

        <scan>

          <horizontal>

            <samples>360</samples>

            <resolution>1</resolution>

            <min_angle>-3.14159</min_angle>

            <max_angle>3.14159</max_angle>

          </horizontal>

        </scan>


        <range>

          <min>0.12</min>

          <max>10.0</max>

          <resolution>0.01</resolution>

        </range>

      </lidar>

    </sensor>

  </gazebo>


  <!-- ====================================================== -->
  <!-- GAZEBO DIFF DRIVE                                      -->
  <!-- ====================================================== -->

  <gazebo>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">


      <!-- ================================================ -->
      <!-- LEFT WHEELS                                      -->
      <!-- ================================================ -->

      <left_joint>
        front_left_wheel_joint
      </left_joint>

      <left_joint>
        rear_left_wheel_joint
      </left_joint>


      <!-- ================================================ -->
      <!-- RIGHT WHEELS                                     -->
      <!-- ================================================ -->

      <right_joint>
        front_right_wheel_joint
      </right_joint>

      <right_joint>
        rear_right_wheel_joint
      </right_joint>


      <!-- ================================================ -->
      <!-- DRIVE GEOMETRY                                   -->
      <!-- ================================================ -->

      <wheel_separation>
        0.102
      </wheel_separation>

      <wheel_radius>
        0.05
      </wheel_radius>


      <!-- ================================================ -->
      <!-- ACCELERATION                                     -->
      <!-- ================================================ -->

      <max_linear_acceleration>
        1.0
      </max_linear_acceleration>

      <min_linear_acceleration>
        -1.0
      </min_linear_acceleration>


      <max_angular_acceleration>
        2.0
      </max_angular_acceleration>

      <min_angular_acceleration>
        -2.0
      </min_angular_acceleration>


      <!-- ================================================ -->
      <!-- VELOCITY                                         -->
      <!-- ================================================ -->

      <max_linear_velocity>
        0.5
      </max_linear_velocity>

      <min_linear_velocity>
        -0.5
      </min_linear_velocity>


      <max_angular_velocity>
        1.0
      </max_angular_velocity>

      <min_angular_velocity>
        -1.0
      </min_angular_velocity>


      <!-- ================================================ -->
      <!-- ODOMETRY                                         -->
      <!-- ================================================ -->

      <odom_publish_frequency>
        50
      </odom_publish_frequency>

      <topic>
        /cmd_vel
      </topic>

      <odom_topic>
        odom
      </odom_topic>

      <tf_topic>
        tf
      </tf_topic>

      <frame_id>
        odom
      </frame_id>

      <child_frame_id>
        base_footprint
      </child_frame_id>

    </plugin>

  </gazebo>


  <!-- ====================================================== -->
  <!-- JOINT STATE PUBLISHER                                  -->
  <!-- ====================================================== -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher"/>


    <!-- ================================================ -->
    <!-- GAZEBO SENSORS                                   -->
    <!-- ================================================ -->

    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">

      <render_engine>
        ogre2
      </render_engine>

    </plugin>

  </gazebo>


</robot>